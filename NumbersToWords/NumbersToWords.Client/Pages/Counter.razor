@page "/"
@using NumbersToWords.Core
@rendermode InteractiveWebAssembly

<PageTitle>Number To String</PageTitle>

<h1>Number To String</h1>

<p>Convert numeric input to dollars and cents</p>

<input @oninput="OnInputChanged" type="number" step="0.01"/>

<h1 class="d-flex justify-content-center">
    @_inputString
</h1>

<div class="d-flex justify-content-around align-content-center">
    <div class="card p-3">
        <div class="card-title">
            <h4>Octillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Octillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Septillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Septillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Sextillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Sextillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Quintillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Quintillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Quadrillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Quadrillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Trillions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Trillions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Billions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Billions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Millions</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Millions.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Thousands</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Thousands.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Hundreds</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Hundreds.Value</h5>
        </div>
    </div>
    <div class="card p-3">
        <div class="card-title">
            <h4>Cents</h4>
        </div>
        <div class="card-body d-flex justify-content-around align-content-center">
            <h5>@_structuredOutput.Cents.Value</h5>
        </div>
    </div>
</div>

@code {
    private decimal _input = 0;
    private string _inputString = string.Empty;
    NumbersToCurrencyWordsStructure _structuredOutput = new NumbersToCurrencyWordsStructure(0);

    private CancellationTokenSource? _debounceTimer;

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        _debounceTimer?.Cancel();
        _debounceTimer = new CancellationTokenSource();

        try
        {
            if (Decimal.TryParse(e.Value?.ToString() ?? "", out var input))
            {
                await Task.Delay(500, _debounceTimer.Token);

                _input = input;
                _structuredOutput = new NumbersToCurrencyWordsStructure(_input);
                _inputString = _structuredOutput.ToString();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            // Do nothing if the timer was reset by a new keystroke
        }
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

}
